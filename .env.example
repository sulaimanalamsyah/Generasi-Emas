# ==============================================================================
# GENERASI EMAS (ENI Care) - Mobile Client Environment Configuration Template
# ==============================================================================
# Copy this template file to '.env' in the Generasi_Emas root directory:
#   cp .env.example .env
# ==============================================================================

# Application Environment Mode (development | staging | production)
APP_ENV=development

# Application Display Name
APP_NAME=ENI Care

# Backend RESTful API Base URL (Without trailing slash)
# - Android Emulator (Default loopback): http://10.0.2.2:4000
# - iOS Simulator / Flutter Web:        http://localhost:4000
# - Physical Android Device via Wi-Fi:  http://192.168.x.x:4000 (Replace with your computer's LAN IP)
# - Production Server:                  https://api-generasiemas.example.com
API_BASE_URL=http://localhost:4000

# Network Request Timeout in Seconds (Default: 10)
API_TIMEOUT_SECONDS=10
